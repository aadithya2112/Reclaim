DATABASE_URL=postgresql://recovery:recovery@localhost:5432/recovery
# Direct, non-pooled PostgreSQL connection used only by controlled migrations.
DATABASE_MIGRATION_URL=postgresql://recovery:recovery@localhost:5432/recovery
DEMO_RESET_ENABLED=false
APP_URL=https://your-public-zrok-url.example
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
# Server-only. The operational interpreter pins openai/gpt-5-mini in code.
OPENROUTER_API_KEY=replace_me
# Deployment notification destination; passed to CloudFormation as NoEcho.
ALERT_EMAIL=alerts@example.com
